# Copy to .env (gitignored) and fill in. Match versions to what work runs in production.
JIRA_VERSION=10.3.25
CONFLUENCE_VERSION=10.2.18
POSTGRES_VERSION=16

POSTGRES_PASSWORD=change-me
ATL_DB_PASSWORD=change-me-too

# License keys. `./dc.ps1 license` fills these with Atlassian's 3-hour test keys; replace with the
# developer license keys when available. Confluence reads its key at first start (ATL_LICENSE_KEY).
# Jira has no env var: paste it in the wizard (`./dc.ps1 license jira -Copy`).
JIRA_LICENSE_KEY=
CONFLUENCE_LICENSE_KEY=

# Jira admin credentials, used by `./dc.ps1 license -Apply` when JIRA_PAT is not set.
JIRA_ADMIN_USER=
JIRA_ADMIN_PASSWORD=

# Personal Access Tokens, created after setup (Profile > Personal Access Tokens). Used by the sdlc-work bridge.
JIRA_BASE_URL=http://jira.localhost:8080
JIRA_PAT=
CONFLUENCE_BASE_URL=http://confluence.localhost:8090
CONFLUENCE_PAT=

# Bitbucket DC (unattended setup; dc.ps1 fills the admin password and license, setup creates the token)
BITBUCKET_BASE_URL=http://bitbucket.localhost:7990
BITBUCKET_TOKEN=

# Jenkins (headless "work this ticket" loop). dc.ps1 generates the admin password; COPILOT_GITHUB_TOKEN is taken
# from `gh auth token` when empty (dev only; a real deployment uses a bot account's token with Copilot access).
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
COPILOT_GITHUB_TOKEN=
# Repo the local poll job works in:
# SDLC_WORK_REPO_URL=http://bitbucket.localhost:7990/scm/sdlc/sandbox.git

# Optional overrides
# JENKINS_PORT=8081
# JIRA_PORT=8080
# CONFLUENCE_PORT=8090
# SYNCHRONY_PORT=8091
# POSTGRES_PORT=5433
# JIRA_HEAP_MAX=3072m
# CONFLUENCE_HEAP_MAX=3072m
